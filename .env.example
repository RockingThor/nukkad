# MCP Server Configuration
MCP_SERVER_URL=http://localhost:3001/mcp
MCP_DEV_BYPASS_AUTH=true

# LLM Provider Configuration
# Use MOCK_LLM=1 to run without API keys (judges can test this way)
MOCK_LLM=1

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=your_deepseek_key_here

# AWS Bedrock (optional, for Nova provider)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Storage Backend
# Options: memory, dynamodb
STORAGE_BACKEND=memory

# DynamoDB Configuration (when STORAGE_BACKEND=dynamodb)
DYNAMODB_TABLE_NAME=nukkad-data
DYNAMODB_ENDPOINT=http://localhost:8000

# Text-to-Speech
# Options: browser, polly
TTS_PROVIDER=browser
