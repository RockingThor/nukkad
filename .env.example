# Copy to packages/nukkad-mcp/.env for local runs. Never commit real values.
DEEPSEEK_API_KEY=
# Set to a DynamoDB table name to use DynamoDB. Leave empty for in memory storage.
NUKKAD_TABLE=
AWS_REGION=us-east-1
# Where the built web app lives, for the local server.
NUKKAD_STATIC_DIR=../../apps/web/out
